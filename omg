local function makePage(name)
    local page = create("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = COLORS.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, content)
    padding(page, 2, 5, 2, 8)
    create("UIListLayout", {
        Padding = UDim.new(0, 11),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)
    pages[name] = page
    return page
end

local function showPage(name)
    currentPage = name
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end
    for buttonName, button in pairs(navButtons) do
        local selected = buttonName == name
        button.BackgroundColor3 = selected and Color3.fromRGB(24, 52, 96) or COLORS.Panel
        button.TextColor3 = selected and COLORS.Text or COLORS.Muted
        local bar = button:FindFirstChild("ActiveBar")
        if bar then bar.BackgroundTransparency = selected and 0 or 1 end
    end
end

local function addNav(name, iconText, order)
    local button = create("TextButton", {
        Name = name .. "Nav",
        LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = COLORS.Panel,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Enum.Font.GothamMedium,
        Text = "   " .. iconText .. "    " .. name,
        TextColor3 = COLORS.Muted,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, navList)
    corner(button, 8)
    local activeBar = create("Frame", {
        Name = "ActiveBar",
        Position = UDim2.new(0, 0, 0, 7),
        Size = UDim2.new(0, 3, 1, -14),
        BackgroundColor3 = COLORS.AccentLight,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, button)
    corner(activeBar, 4)
    navButtons[name] = button
    button.MouseButton1Click:Connect(function() showPage(name) end)
    button.MouseEnter:Connect(function()
        if currentPage ~= name then
            TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.Panel2}):Play()
        end
    end)
    button.MouseLeave:Connect(function()
        if currentPage ~= name then
            TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.Panel}):Play()
        end
    end)
end

