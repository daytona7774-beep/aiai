local function addToggle(parent, label, initial, callback)
    local row = create("Frame", {
        Position = UDim2.fromOffset(0, 27),
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
    }, parent)
    create("TextLabel", {
        Size = UDim2.new(1, -58, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = label,
        TextColor3 = COLORS.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local toggle = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(42, 22),
        BackgroundColor3 = initial and COLORS.Accent or Color3.fromRGB(45, 51, 68),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(toggle, 12)
    local knob = create("Frame", {
        Position = initial and UDim2.new(1, -19, 0, 3) or UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, toggle)
    corner(knob, 10)
    local enabled = initial
    toggle.MouseButton1Click:Connect(function()
        enabled = not enabled
        TweenService:Create(toggle, TweenInfo.new(0.15), {
            BackgroundColor3 = enabled and COLORS.Accent or Color3.fromRGB(45, 51, 68)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = enabled and UDim2.new(1, -19, 0, 3) or UDim2.fromOffset(3, 3)
        }):Play()
        if callback then callback(enabled) end
    end)
end

local function addSlider(parent, label, minValue, maxValue, defaultValue, callback)
    local row = create("Frame", {
        Position = UDim2.fromOffset(0, 27),
        Size = UDim2.new(1, 0, 0, 53),
        BackgroundTransparency = 1,
    }, parent)
    local valueLabel = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 17),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = label,
        TextColor3 = COLORS.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local numberLabel = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(45, 17),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = tostring(defaultValue),
        TextColor3 = COLORS.AccentLight,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)
    local track = create("Frame", {
        Position = UDim2.fromOffset(0, 29),
        Size = UDim2.new(1, 0, 0, 6),
        BackgroundColor3 = Color3.fromRGB(42, 49, 67),
        BorderSizePixel = 0,
    }, row)
    corner(track, 5)
    local ratio = (defaultValue - minValue) / (maxValue - minValue)
    local fill = create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 5)
    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(ratio, 0, 0.5, 0),
        Size = UDim2.fromOffset(13, 13),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, 8)
    local hitbox = create("TextButton", {
        Position = UDim2.new(0, 0, 0, -8),
        Size = UDim2.new(1, 0, 1, 16),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, track)
    local dragging = false
    local value = defaultValue
    local function setFromX(x)
        local r = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(minValue + (maxValue - minValue) * r + 0.5)
        local p = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        numberLabel.Text = tostring(value)
        if callback then callback(value) end
    end
    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

