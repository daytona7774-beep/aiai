local function refreshPlayers()
    for _, child in ipairs(playerScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local query = string.lower(search.Text)
    for _, target in ipairs(Players:GetPlayers()) do
        if query == "" or string.find(string.lower(target.Name), query, 1, true)
            or string.find(string.lower(target.DisplayName), query, 1, true) then
            local row = create("Frame", {
                Name = target.Name,
                Size = UDim2.new(1, -4, 0, 42),
                BackgroundColor3 = COLORS.Panel2,
                BorderSizePixel = 0,
            }, playerScroll)
            corner(row, 8)
            local avatar = create("ImageLabel", {
                Position = UDim2.fromOffset(6, 5),
                Size = UDim2.fromOffset(32, 32),
                BackgroundColor3 = COLORS.Background,
                BorderSizePixel = 0,
                Image = "",
            }, row)
            corner(avatar, 7)
            task.spawn(function()
                local ok, imageUrl = pcall(function()
                    return Players:GetUserThumbnailAsync(target.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                end)
                if ok and avatar.Parent then avatar.Image = imageUrl end
            end)
            create("TextLabel", {
                Position = UDim2.fromOffset(47, 5),
                Size = UDim2.new(1, -54, 0, 17),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = target.DisplayName,
                TextColor3 = COLORS.Text,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, row)
            create("TextLabel", {
                Position = UDim2.fromOffset(47, 22),
                Size = UDim2.new(1, -54, 0, 14),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = "@" .. target.Name .. "  •  ID " .. tostring(target.UserId),
                TextColor3 = COLORS.Muted,
                TextSize = 9,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, row)
        end
    end
end

