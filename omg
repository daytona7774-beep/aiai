--==================================================
-- ARCANE UI - FIXED STANDALONE VERSION
-- Für Roblox Studio: als LocalScript ausführen
--==================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
if not player then
    error("Arcane UI benötigt einen Roblox LocalScript.")
end

local playerGui = player:WaitForChild("PlayerGui")

local Arcane = {}
Arcane.__index = Arcane

Arcane.Theme = {
    Background = Color3.fromRGB(17, 18, 25),
    Sidebar = Color3.fromRGB(22, 23, 32),
    Panel = Color3.fromRGB(28, 30, 41),
    Element = Color3.fromRGB(38, 40, 54),
    Accent = Color3.fromRGB(139, 92, 246),
    Text = Color3.fromRGB(240, 240, 250),
    Muted = Color3.fromRGB(155, 158, 180),
    Border = Color3.fromRGB(53, 55, 73)
}

local T = Arcane.Theme

local function create(className, properties, parent)
    assert(
        Instance ~= nil,
        "Instance ist nil: Dieses Script muss in einer Roblox-LuaU-Umgebung laufen."
    )

    local object = Instance.new(className)

    for key, value in pairs(properties or {}) do
        object[key] = value
    end

    if parent then
        object.Parent = parent
    end

    return object
end

local function corner(object, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, object)
end

local function stroke(object)
    create("UIStroke", {
        Color = T.Border,
        Thickness = 1
    }, object)
end

local function addPadding(object, amount)
    create("UIPadding", {
        PaddingLeft = UDim.new(0, amount),
        PaddingRight = UDim.new(0, amount),
        PaddingTop = UDim.new(0, amount),
        PaddingBottom = UDim.new(0, amount)
    }, object)
end

local function makeLabel(parent, text, size, color, font)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextSize = size or 13,
        TextColor3 = color or T.Text,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 1, 0)
    }, parent)
end

local function makeButton(parent, text, size)
    local b = create("TextButton", {
        AutoButtonColor = false,
        Text = text or "",
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextColor3 = T.Text,
        BackgroundColor3 = T.Element,
        Size = size,
        BorderSizePixel = 0
    }, parent)

    corner(b, 7)

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = T.Accent
        }):Play()
    end)

    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = T.Element
        }):Play()
    end)

    return b
end

--==================================================
-- FENSTER
--==================================================

function Arcane.new(options)
    options = options or {}

    local self = setmetatable({}, Arcane)

    self.Tabs = {}
    self.Connections = {}
    self.ActiveTab = nil
    self.Destroyed = false

    local existing = playerGui:FindFirstChild(options.Name or "ArcaneUI")
    if existing then
        existing:Destroy()
    end

    self.Gui = create("ScreenGui", {
        Name = options.Name or "ArcaneUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,

    }, playerGui)

    local main = create("Frame", {
        Name = "Main",
        Size = options.Size or UDim2.fromOffset(760, 490),
        Position = UDim2.new(0.5, -380, 0.5, -245),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, self.Gui)

    self.Main = main
    corner(main, 12)
    stroke(main)

    local topbar = create("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 55),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0
    }, main)

    local title = makeLabel(
        topbar,
        "  ✦  " .. (options.Title or "ARCANE"),
        16,
        T.Text,
        Enum.Font.GothamBold
    )

    title.Position = UDim2.fromOffset(0, -5)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(18, 28),
        Size = UDim2.new(1, -75, 0, 16),
        Text = options.Subtitle or "Custom Interface",
        TextSize = 10,
        TextColor3 = T.Muted,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, topbar)

    local close = makeButton(
        topbar,
        "×",
        UDim2.fromOffset(32, 32)
    )

    close.Position = UDim2.new(1, -42, 0, 11)
    close.TextSize = 22

    close.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    local sidebar = create("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(0, 55),
        Size = UDim2.new(0, 170, 1, -55),
        BackgroundColor3 = T.Sidebar,
        BorderSizePixel = 0
    }, main)

    addPadding(sidebar, 10)

    local tabList = create("ScrollingFrame", {
        Name = "TabList",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = T.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y
    }, sidebar)

    create("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, tabList)

    self.Content = create("Frame", {
        Name = "Content",
        Position = UDim2.new(0, 170, 0, 55),
        Size = UDim2.new(1, -170, 1, -55),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, main)

    self.TabList = tabList

    -- Fenster verschieben
    local dragging = false
    local dragStart
    local startPosition
    local dragInput

    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    topbar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    local moveConnection = UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart

            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    table.insert(self.Connections, moveConnection)

    return self
end

--==================================================
-- TABS
--==================================================

function Arcane:SelectTab(selected)
    self.ActiveTab = selected

    for _, tab in ipairs(self.Tabs) do
        tab.Page.Visible = tab == selected

        tab.Button.BackgroundColor3 =
            tab == selected and T.Accent or T.Element
    end
end

function Arcane:CreateTab(name)
    local tab = {
        Name = name,
        Sections = {},
        Window = self
    }

    tab.Button = makeButton(
        self.TabList,
        "   " .. name,
        UDim2.new(1, 0, 0, 36)
    )

    tab.Button.TextXAlignment = Enum.TextXAlignment.Left

    tab.Page = create("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = T.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false
    }, self.Content)

    addPadding(tab.Page, 14)

    create("UIListLayout", {
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, tab.Page)

    tab.Button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    --==================================================
    -- SECTIONS
    --==================================================

    function tab:CreateSection(sectionName)
        local section = {
            Name = sectionName,
            Tab = self
        }

        local frame = create("Frame", {
            Name = sectionName,
            Size = UDim2.new(1, -4, 0, 40),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = T.Panel,
            BorderSizePixel = 0
        }, self.Page)

        corner(frame, 9)
        stroke(frame)
        addPadding(frame, 12)

        create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, frame)

        create("TextLabel", {
            Name = "Heading",
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
            Text = sectionName,
            TextSize = 14,
            TextColor3 = T.Text,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 0
        }, frame)

        section.Frame = frame

        local function row(height, order)
            return create("Frame", {
                Size = UDim2.new(1, 0, 0, height),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                LayoutOrder = order or 1
            }, frame)
        end

        -- TOGGLE
        function section:AddToggle(text, default, callback)
            local r = row(32)
            local caption = makeLabel(r, text, 12, T.Text)
            caption.Size = UDim2.new(1, -55, 1, 0)

            local switch = create("TextButton", {
                Size = UDim2.fromOffset(42, 22),
                Position = UDim2.new(1, -42, 0.5, -11),
                BackgroundColor3 = T.Element,
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0
            }, r)

            corner(switch, 11)

            local knob = create("Frame", {
                Size = UDim2.fromOffset(16, 16),
                Position = UDim2.new(0, 3, 0.5, -8),
                BackgroundColor3 = T.Text,
                BorderSizePixel = 0
            }, switch)

            corner(knob, 9)

            local value = default == true

            local function update(notify)
                switch.BackgroundColor3 = value and T.Accent or T.Element

                knob.Position = value
                    and UDim2.new(1, -19, 0.5, -8)
                    or UDim2.new(0, 3, 0.5, -8)

                if notify and callback then
                    callback(value)
                end
            end

            switch.MouseButton1Click:Connect(function()
                value = not value
                update(true)
            end)

            update(false)

            return {
                Get = function()
                    return value
                end,

                Set = function(newValue)
                    value = newValue == true
                    update(true)
                end
            }
        end

        -- BUTTON
        function section:AddButton(text, callback)
            local b = makeButton(
                frame,
                text,
                UDim2.new(1, 0, 0, 34)
            )

            b.LayoutOrder = 10

            b.MouseButton1Click:Connect(function()
                if callback then
                    callback()
                end
            end)

            return b
        end

        -- TEXTBOX
        function section:AddTextBox(text, placeholder, callback)
            local r = row(58)

            local caption = makeLabel(r, text, 12, T.Text)
            caption.Size = UDim2.new(1, 0, 0, 20)

            local input = create("TextBox", {
                Position = UDim2.fromOffset(0, 24),
                Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = T.Element,
                TextColor3 = T.Text,
                PlaceholderColor3 = T.Muted,
                PlaceholderText = placeholder or "Text eingeben...",
                Text = "",
                TextSize = 12,
                Font = Enum.Font.Gotham,
                ClearTextOnFocus = false,
                BorderSizePixel = 0
            }, r)

            corner(input, 6)
            addPadding(input, 8)

            input.FocusLost:Connect(function(enterPressed)
                if callback then
                    callback(input.Text, enterPressed)
                end
            end)

            return input
        end

        -- SLIDER
        function section:AddSlider(text, minValue, maxValue, defaultValue, callback)
            minValue = minValue or 0
            maxValue = maxValue or 100
            defaultValue = math.clamp(
                defaultValue or minValue,
                minValue,
                maxValue
            )

            local r = row(54)

            local caption = makeLabel(r, text, 12, T.Text)
            caption.Size = UDim2.new(0.75, 0, 0, 22)

            local number = create("TextLabel", {
                Position = UDim2.new(0.75, 0, 0, 0),
                Size = UDim2.new(0.25, 0, 0, 22),
                BackgroundTransparency = 1,
                Text = tostring(defaultValue),
                TextColor3 = T.Accent,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Right
            }, r)

            local bar = create("TextButton", {
                Position = UDim2.fromOffset(0, 31),
                Size = UDim2.new(1, 0, 0, 8),
                BackgroundColor3 = T.Element,
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0
            }, r)

            corner(bar, 4)

            local fill = create("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = T.Accent,
                BorderSizePixel = 0
            }, bar)

            corner(fill, 4)

            local value = defaultValue
            local sliding = false

            local function setValue(newValue, notify)
                value = math.clamp(
                    math.floor(newValue + 0.5),
                    minValue,
                    maxValue
                )

                local ratio = (value - minValue) /
                    math.max(maxValue - minValue, 1)

                fill.Size = UDim2.new(ratio, 0, 1, 0)
                number.Text = tostring(value)

                if notify and callback then
                    callback(value)
                end
            end

            local function fromX(x)
                local width = math.max(bar.AbsoluteSize.X, 1)
                local ratio = math.clamp(
                    (x - bar.AbsolutePosition.X) / width,
                    0,
                    1
                )

                setValue(
                    minValue + ratio * (maxValue - minValue),
                    true
                )
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    fromX(input.Position.X)
                end
            end)

            local move = UserInputService.InputChanged:Connect(function(input)
                if sliding and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    fromX(input.Position.X)
                end
            end)

            local finish = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            table.insert(self.Window.Connections, move)
            table.insert(self.Window.Connections, finish)

            setValue(defaultValue, false)

            return {
                Get = function()
                    return value
                end,

                Set = function(newValue)
                    setValue(newValue, true)
                end
            }
        end

        -- DROPDOWN
        function section:AddDropdown(text, options, callback)
            options = options or {}

            local r = row(61)

            local caption = makeLabel(r, text, 12, T.Text)
            caption.Size = UDim2.new(1, 0, 0, 20)

            local selected = options[1]

            local drop = makeButton(
                r,
                selected and tostring(selected) or "Option wählen",
                UDim2.new(1, 0, 0, 32)
            )

            drop.Position = UDim2.fromOffset(0, 24)
            drop.TextXAlignment = Enum.TextXAlignment.Left

            local menu = create("Frame", {
                Position = UDim2.new(0, 0, 0, 59),
                Size = UDim2.new(1, 0, 0, 0),
                BackgroundColor3 = T.Background,
                BorderSizePixel = 0,
                Visible = false,
                ClipsDescendants = true,
                ZIndex = 5
            }, r)

            corner(menu, 6)
            stroke(menu)

            create("UIListLayout", {
                Padding = UDim.new(0, 3),
                SortOrder = Enum.SortOrder.LayoutOrder
            }, menu)

            local function rebuild()
                for _, child in ipairs(menu:GetChildren()) do
                    if child:IsA("TextButton") then
                        child:Destroy()
                    end
                end

                for _, option in ipairs(options) do
                    local optionButton = makeButton(
                        menu,
                        tostring(option),
                        UDim2.new(1, 0, 0, 28)
                    )

                    optionButton.ZIndex = 6

                    optionButton.MouseButton1Click:Connect(function()
                        selected = option
                        drop.Text = tostring(option)
                        menu.Visible = false
                        menu.Size = UDim2.new(1, 0, 0, 0)
                        r.Size = UDim2.new(1, 0, 0, 61)

                        if callback then
                            callback(option)
                        end
                    end)
                end
            end

            rebuild()

            drop.MouseButton1Click:Connect(function()
                menu.Visible = not menu.Visible

                if menu.Visible then
                    local height = math.min(#options * 31, 155)
                    menu.Size = UDim2.new(1, 0, 0, height)
                    r.Size = UDim2.new(1, 0, 0, 67 + height)
                else
                    menu.Size = UDim2.new(1, 0, 0, 0)
                    r.Size = UDim2.new(1, 0, 0, 61)
                end
            end)

            return {
                Get = function()
                    return selected
                end,

                Set = function(newValue)
                    for _, option in ipairs(options) do
                        if option == newValue then
                            selected = newValue
                            drop.Text = tostring(newValue)

                            if callback then
                                callback(newValue)
                            end

                            return
                        end
                    end
                end,

                Refresh = function(newOptions)
                    options = newOptions or {}
                    selected = options[1]
                    drop.Text = selected and tostring(selected) or "Option wählen"
                    rebuild()
                end
            }
        end

        -- KEYBIND
        function section:AddKeybind(text, defaultKey, callback)
            local r = row(34)

            local caption = makeLabel(r, text, 12, T.Text)
            caption.Size = UDim2.new(1, -105, 1, 0)

            local keyName = defaultKey or "RightShift"

            local keyButton = makeButton(
                r,
                keyName,
                UDim2.fromOffset(100, 30)
            )

            keyButton.Position = UDim2.new(1, -100, 0, 2)

            local listening = false

            keyButton.MouseButton1Click:Connect(function()
                listening = true
                keyButton.Text = "Taste drücken..."
            end)

            local connection = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then
                    return
                end

                if listening then
                    keyName = input.KeyCode.Name
                    keyButton.Text = keyName
                    listening = false
                    return
                end

                if input.KeyCode.Name == keyName and callback then
                    callback(keyName)
                end
            end)

            table.insert(self.Window.Connections, connection)

            return {
                Get = function()
                    return keyName
                end,

                Set = function(newKey)
                    keyName = newKey
                    keyButton.Text = newKey
                end
            }
        end

        table.insert(self.Sections, section)
        return section
    end

    return tab
end

--==================================================
-- BENACHRICHTIGUNG
--==================================================

function Arcane:Notify(titleText, messageText, duration)
    duration = duration or 3

    local note = create("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -20, 0, 20),
        Size = UDim2.fromOffset(290, 80),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
        ZIndex = 20
    }, self.Gui)

    corner(note, 9)
    stroke(note)

    create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
        ZIndex = 21
    }, note)

    create("TextLabel", {
        Position = UDim2.fromOffset(15, 8),
        Size = UDim2.new(1, -25, 0, 24),
        BackgroundTransparency = 1,
        Text = titleText or "Arcane",
        TextSize = 14,
        TextColor3 = T.Text,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 21
    }, note)

    create("TextLabel", {
        Position = UDim2.fromOffset(15, 33),
        Size = UDim2.new(1, -25, 0, 38),
        BackgroundTransparency = 1,
        Text = messageText or "",
        TextWrapped = true,
        TextSize = 11,
        TextColor3 = T.Muted,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 21
    }, note)

    task.delay(duration, function()
        if note and note.Parent then
            TweenService:Create(note, TweenInfo.new(0.2), {
                BackgroundTransparency = 1,
                Position = note.Position + UDim2.fromOffset(0, -8)
            }):Play()

            task.wait(0.22)

            if note and note.Parent then
                note:Destroy()
            end
        end
    end)

    return note
end

--==================================================
-- AUFRÄUMEN
--==================================================

function Arcane:Destroy()
    if self.Destroyed then
        return
    end

    self.Destroyed = true

    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    if self.Gui then
        self.Gui:Destroy()
    end
end

